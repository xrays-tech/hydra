# Rust build artifacts
/target

# Backup files from rustfmt
**/*.rs.bk
**/*.rs.swp

# Local SQLite data directory (created at runtime by hydra-server)
/data

# SQLite database files created at workspace root by integration tests
/hydra.db
/hydra.db-shm
/hydra.db-wal

# Cross-compiled Linux binary staged for Docker (built by environment/build.sh)
/bin/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/

# AI agent / tool local state (never commit)
.claude/
.opencode/
.agents/
.cursor/
.aider*
.continue/
.codeium/
.windsurf/
# BEGIN oh-my-opencode-slim (worktrees + local state)
.slim/
# END oh-my-opencode-slim

# Secrets / certs / sensitive material (never commit)
/secure/

# Local 3-node test environment runbook -> contains a real upstream api-key
/LOCAL_TEST_ENV.md

# Code-review report -> describes issues that are still UNFIXED; this repo is
# public, so keep it local until the remaining findings are addressed.
/CODE_REVIEW.md

# Local release script (per-developer convenience wrapper)
/scripts/local_release.sh

# Locally staged server binary (built by scripts/local_release.sh)
/environment/bin/
/bin/

# Docker CLI/buildx state, redirected here for the local test environment
/.docker/
/.buildx/

# Temporary local tooling (sqlx-cli bootstrap cache; deleted after .sqlx regen)
/.cargo-cache/
/.acceptance/
