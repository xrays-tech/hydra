# Rust build artifacts
/target

# Backup files from rustfmt
**/*.rs.bk
**/*.rs.swp

# Local SQLite data directory (created at runtime by hydra-server)
/data

# SQLite database files created at the workspace root by integration tests and by
# in-place runs. The `-shm`/`-wal` sidecars matter most: they are rewritten on every
# run and were committed by accident once (`e2e_test.db-shm`, `e2e_test.db-wal`).
/*.db
/*.db-shm
/*.db-wal
/*.db-journal

# Runtime leftovers: pid files. The acceptance gate writes its own into $RUN, but
# `hydra.pid` was written at the repo root before that and got committed.
*.pid

# Python byte-code caches (environment/init.py, tools/hydra-py/**).
__pycache__/
*.pyc

# Cross-compiled Linux binary staged for Docker (built by environment/build.sh)
/bin/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/

# AI agent / tool local state (never commit)
.claude/
.opencode/
.agents/
.cursor/
.aider*
.continue/
.codeium/
.windsurf/
# BEGIN oh-my-opencode-slim (worktrees + local state)
.slim/
# END oh-my-opencode-slim

# Secrets / certs / sensitive material (never commit)
/secure/

# Local 3-node test environment runbook -> contains a real upstream api-key
/LOCAL_TEST_ENV.md

# Code-review report -> describes issues that are still UNFIXED; this repo is
# public, so keep it local until the remaining findings are addressed.
/CODE_REVIEW.md

# Local release script (per-developer convenience wrapper)
/scripts/local_release.sh

# Locally staged server binary (built by scripts/local_release.sh)
/environment/bin/
/bin/

# Docker CLI/buildx state, redirected here for the local test environment
/.docker/
/.buildx/

# Temporary local tooling (sqlx-cli bootstrap cache; deleted after .sqlx regen)
/.cargo-cache/

# The acceptance EVIDENCE CHAIN is version-controlled (decision D-5, option ②). It used to be the whole
# directory (`/.acceptance/`), so a fresh clone had NO gate and CI could not reference one: `git ls-files
# .acceptance` was 0 while the plan and §4 both told an operator to run `.acceptance/round10-gate.sh`.
#
# Git cannot re-include a file whose PARENT directory is excluded, so the directory is un-ignored first
# and its contents are filtered instead. Shell/Python only: the scratch state stays out (`.log`,
# `e2e-local/`, `tmp-pw/`, `pw-browsers/`, `gate-manifest.txt`, round data).
/.acceptance/*
!/.acceptance/*.sh
!/.acceptance/*.py
# …except the drafts. These are one-off probes and stale copies whose value is their OUTPUT, which the
# plan already records; tracking them would put ~12 dead scripts in every clone. Add one back the day a
# record cites it as the way to reproduce something.
/.acceptance/bak-*.py
/.acceptance/extract_*.py
/.acceptance/tmp-*.py
/.acceptance/tmp-*.sh
/.acceptance/round*-probe*.sh
/.acceptance/round*-probe*.py

# Playwright (the e2e suite writes these into the repo root; `.dockerignore`
# already excluded them, but an unclean `git status` after a local e2e run is
# how a stray artefact gets committed by accident.)
test-results/
playwright-report/

# Arachne Phase 0 evaluation artefacts (docs snapshot, upstream checkout, probes).
/.arachne-research/
