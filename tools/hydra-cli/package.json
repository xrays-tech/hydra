{
  "name": "hydra-admin",
  "version": "1.0.2",
  "description": "Command-line client for the Hydra LLM gateway admin REST API.",
  "type": "module",
  "bin": {
    "hydra-admin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/client.test.js"
  },
  "keywords": [
    "hydra",
    "llm",
    "gateway",
    "router",
    "cli",
    "admin"
  ],
  "author": "ipconfiger",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ipconfiger/hydra"
  },
  "homepage": "https://github.com/ipconfiger/hydra/tree/main/tools/hydra-cli",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
