# Hydra production environment — TEMPLATE ONLY (committed).
#
# `ops/up.sh` writes a real `prod/.env` with generated secrets when the file is absent;
# never commit that file (see prod/.gitignore). Copy this file if you prefer to fill it by
# hand, then `chmod 600 .env`.
#
# Listener addresses are NOT here: Hydra IS the edge, so `HYDRA_LISTEN=0.0.0.0:80` and
# `HYDRA_TLS_LISTEN=0.0.0.0:443` live in the committed `env/app.env`.
#
# `HYDRA_TRUSTED_PROXIES` is intentionally UNSET: Hydra is the edge and there is no proxy in front
# of it, so the socket peer address is authoritative and X-Forwarded-For is ignored. Set it only if
# you later put a trusted LB in front; otherwise leaving it unset is the safest configuration.

POSTGRES_USER=hydra
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=hydra

REDIS_PASSWORD=replace-with-random-hex

# Postgres over the private compose network. For a hardened deployment terminate TLS at
# Postgres and set sslmode=require + HYDRA_DB_REQUIRE_TLS=1 (see README).
HYDRA_DB_URL=postgres://hydra:replace-with-random-hex@postgres:5432/hydra?sslmode=disable
HYDRA_DB_REQUIRE_TLS=0

# Redis over the private compose network, password required.
HYDRA_REDIS_URL=redis://:replace-with-random-hex@redis:6379
HYDRA_REDIS_REQUIRE_AUTH=1

# `openssl rand -hex 32`
HYDRA_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# `openssl rand -base64 32` — losing this makes stored provider keys unreadable.
HYDRA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
HYDRA_ENCRYPTION_KEY_VERSION=1

HYDRA_USAGE_SINK=greptimedb
HYDRA_GREPTIMEDB_URL=http://greptimedb:4000/hydra_usage

# Single shared Redis instance: one live breaker vote is a quorum.
HYDRA_BREAKER_QUORUM=1

HYDRA_SHUTDOWN_DRAIN_SECS=20
RUST_LOG=info

# Host port for the admin API. Bind it to loopback (or firewall it) — the bearer token is the
# only authority on this plaintext port.
ADMIN_PORT=18081
