# hydra-prod — the single edge instance.
# Committed: these are topology identifiers, not secrets.
# The app listens plaintext on :80 and per-tenant TLS/SNI on :443; the admin API stays internal
# (published on the host by compose as ${ADMIN_PORT:-18081}).
HYDRA_NODE_ID=hydra-prod
HYDRA_LISTEN=0.0.0.0:80
HYDRA_TLS_LISTEN=0.0.0.0:443
HYDRA_ADMIN_ADDR=0.0.0.0:8081
